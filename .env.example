# Copy to .env at the repository root. Never commit credentials.
DATASET_PATH=backend/data/demo-network.json
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
GRAPH_CACHE_SIZE=1
# Optional: required only for the Supabase import/export commands.
# Use a Supabase direct or session-pooler Postgres connection with SSL.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
DATABASE_URL=
# Public browser token only. Restrict it to the deployed frontend domains.
VITE_MAPBOX_TOKEN=
